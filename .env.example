# Kopioi .env.local (paikallinen) tai GitHub Secrets (tuotanto).
# Katso docs/DEPLOY-CLOUDFLARE.md

# --- Supabase (pakollinen) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sivusto ---
NEXT_PUBLIC_SITE_URL=https://remonttireitti.fi
NEXT_PUBLIC_COMPANY_NAME=Remonttireitti
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_YTUNNUS=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_EMAIL=info@remonttireitti.fi
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_PRIVACY_EMAIL=info@remonttireitti.fi
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# --- Analytiikka & hakukoneet (suositeltu tuotannossa) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Sähköposti ---
RESEND_API_KEY=
EMAIL_FROM=Remonttireitti <noreply@remonttireitti.fi>

# --- Cron & admin ---
CRON_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
ADMIN_NOTIFY_EMAIL=
PLATFORM_FEE_BETA_FREE_DEALS=3

# --- Cloudflare deploy (GitHub Actions) ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
